{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docfx [rebuild docs]",
            "command": "docfx",
            "type": "shell",
            "options": {
                "cwd": "./docs"
            },
            "problemMatcher": []
        },
        {
            "label": "docfx [rebuild docs and serve]",
            "command": "docfx",
            "type": "shell",
            "args": [ "--serve" ],
            "options": {
                "cwd": "./docs"
            },
            "problemMatcher": []
        },
        {
            "label": "dotnet build [Solution]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [Solution, Release]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.sln",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore/SonghayCore.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore, Release]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore/SonghayCore.csproj",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet pack [SonghayCore, Debug]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "pack",
                "${workspaceFolder}/SonghayCore/SonghayCore.csproj",
                "--configuration",
                "Debug",
                "-p:NuspecFile=${workspaceFolder}/SonghayCore/SonghayCore.nuspec",
                "-p:NuspecBasePath=${workspaceFolder}/SonghayCore",
                "--output",
                "${workspaceFolder}/SonghayCore",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore.Tests]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.Tests/SonghayCore.Tests.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet test [SonghayCore.Tests]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "${workspaceFolder}/SonghayCore.Tests/SonghayCore.Tests.csproj",
                "--logger:trx",
                "--results-directory:${workspaceFolder}/TestResults",
                "--verbosity:normal",
                "--collect:\"XPlat Code Coverage\""
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "reportgenerator [SonghayCore.Tests]",
            "command": "reportgenerator",
            "type": "shell",
            "args": [
                "-reports:\"${workspaceFolder}/TestResults/*/coverage.cobertura.xml\"",
                "-reporttypes:Html",
                "-targetdir:\"${workspaceFolder}/docs/coverlet\"",
                "-title:SonghayCore"
            ],
            "problemMatcher": []
        },
        {
            "label": "dotnet build [SonghayCore.Tests, Release]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.Tests/SonghayCore.Tests.csproj",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet test [SonghayCore.Tests, filtered by selected text]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "${workspaceFolder}/SonghayCore.Tests/SonghayCore.Tests.csproj",
                "--filter:${selectedText}",
                "--logger:trx",
                "--results-directory:${workspaceFolder}/TestResults",
                "--verbosity:normal"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore.S3]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.S3/SonghayCore.S3.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore.S3, Release]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.S3/SonghayCore.S3.csproj",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet pack [SonghayCore.S3, Debug]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "pack",
                "${workspaceFolder}/SonghayCore.S3/SonghayCore.S3.csproj",
                "--configuration",
                "Debug",
                "-p:NuspecFile=${workspaceFolder}/SonghayCore.S3/SonghayCore.S3.nuspec",
                "-p:NuspecBasePath=${workspaceFolder}/SonghayCore.S3",
                "--output",
                "${workspaceFolder}/SonghayCore.S3",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet publish [SonghayCore.S3.Shell, linux-x64]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/SonghayCore.S3.Shell/SonghayCore.S3.Shell.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "--configuration",
                "Release",
                "--self-contained",
                "false",
                "--runtime",
                "linux-x64"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore.S3.Tests, Release]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.S3.Tests/SonghayCore.S3.Tests.csproj",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet test [SonghayCore.S3.Tests, filtered by selected text]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "test",
                "${workspaceFolder}/SonghayCore.S3.Tests/SonghayCore.S3.Tests.csproj",
                "--filter:${selectedText}",
                "--logger:trx",
                "--results-directory:${workspaceFolder}/TestResults",
                "--verbosity:normal"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore.xUnit]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.xUnit/SonghayCore.xUnit.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet build [SonghayCore.xUnit, Release]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/SonghayCore.xUnit/SonghayCore.xUnit.csproj",
                "--configuration",
                "Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "dotnet pack [SonghayCore.xUnit, Debug]",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "pack",
                "${workspaceFolder}/SonghayCore.xUnit/SonghayCore.xUnit.csproj",
                "--configuration",
                "Debug",
                "-p:NuspecFile=${workspaceFolder}/SonghayCore.xUnit/SonghayCore.xUnit.nuspec",
                "-p:NuspecBasePath=${workspaceFolder}/SonghayCore.xUnit",
                "--output",
                "${workspaceFolder}/SonghayCore.xUnit",
                "--verbosity",
                "normal"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
