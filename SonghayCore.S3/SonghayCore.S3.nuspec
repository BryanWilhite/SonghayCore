<?xml version="1.0" encoding="utf-8"?>
<package>
    <metadata>
        <id>SonghayCore.S3</id>
        <version>10.0.2</version>
        <description>AWS S3 routines for .NET Core</description>
        <authors>Bryan D. Wilhite</authors>
        <title>Songhay Core Cloud Storage for AWS S3</title>
        <owners>Bryan D. Wilhite</owners>
        <projectUrl>https://github.com/BryanWilhite/SonghayCore</projectUrl>
        <icon>images\songhay_icon.png</icon>
        <license type="file">LICENSE.md</license>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <summary>AWS S3 routines for .NET Core</summary>
        <readme>README.md</readme>
        <releaseNotes>see https://github.com/BryanWilhite/SonghayCore/issues/200 📓</releaseNotes>
        <copyright>(c) 2026 Bryan D. Wilhite</copyright>
        <tags>Core Songhay Amazon S3 AWS Bucket S3Object</tags>
        <repository type="git" url="https://github.com/BryanWilhite/SonghayCore" />
        <dependencies>
            <group targetFramework=".net10.0">
                <dependency id="OneOf" version="3.0.271"/>
                <dependency id="SonghayCore" version="10.0.2"/>
                <dependency id="AWSSDK.S3" version="4.0.102.4"/>
            </group>
        </dependencies>
    </metadata>
    <files>
        <file src="bin\Debug\net10.0\Songhay*.dll" target="lib\net10.0"/>
        <file src="bin\Debug\net10.0\Songhay*.json" target="lib\net10.0"/>
        <file src="**\*.cs" exclude="**\obj\**" target="src"/>
        <file src="..\LICENSE.md" target=""/>
        <file src="..\README.md" target=""/>
        <file src="..\songhay_icon.png" target="images\"/>
    </files>
</package>
